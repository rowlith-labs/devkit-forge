{
  "name": "@devkit-forge/import-react",
  "version": "0.1.1",
  "description": "Headless React hooks for the DevKit Forge data import engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@devkit-forge/import-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourdevujjawal/devkit-forge.git",
    "directory": "packages/import-react"
  },
  "homepage": "https://github.com/yourdevujjawal/devkit-forge/tree/main/packages/import-react#readme",
  "bugs": {
    "url": "https://github.com/yourdevujjawal/devkit-forge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "devkit-forge",
    "data-import",
    "typescript",
    "react",
    "hooks"
  ]
}

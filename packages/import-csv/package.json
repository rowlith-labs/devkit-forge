{
  "name": "@devkit-forge/import-csv",
  "version": "0.1.0",
  "description": "CSV parsing adapter for the DevKit Forge data import engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@devkit-forge/import-core": "workspace:*",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

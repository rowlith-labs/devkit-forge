{
  "name": "@rowlith/import-csv",
  "version": "0.2.0",
  "description": "CSV parsing adapter for the Rowlith data import engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rowlith/import-core": "workspace:*",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "jsdom": "^26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rowlith-labs/rowlith.git",
    "directory": "packages/import-csv"
  },
  "homepage": "https://github.com/rowlith-labs/rowlith/tree/main/packages/import-csv#readme",
  "bugs": {
    "url": "https://github.com/rowlith-labs/rowlith/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rowlith",
    "data-import",
    "typescript",
    "csv",
    "papaparse"
  ]
}

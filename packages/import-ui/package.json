{
  "name": "@rowlith/import-ui",
  "version": "0.1.1",
  "description": "Accessible framework-independent Web Component for Rowlith data imports",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rowlith/import-core": "workspace:*",
    "@rowlith/import-csv": "workspace:*",
    "@rowlith/import-xlsx": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rowlith-labs/rowlith.git",
    "directory": "packages/import-ui"
  },
  "homepage": "https://github.com/rowlith-labs/rowlith/tree/main/packages/import-ui#readme",
  "bugs": {
    "url": "https://github.com/rowlith-labs/rowlith/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rowlith",
    "data-import",
    "typescript",
    "web-component",
    "custom-elements",
    "browser-ui"
  ]
}

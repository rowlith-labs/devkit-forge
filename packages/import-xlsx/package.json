{
  "name": "@devkit-forge/import-xlsx",
  "version": "0.1.0",
  "description": "XLSX workbook parsing adapter for the DevKit Forge data import engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@devkit-forge/import-core": "workspace:*",
    "exceljs-hardened": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourdevujjawal/devkit-forge.git",
    "directory": "packages/import-xlsx"
  },
  "homepage": "https://github.com/yourdevujjawal/devkit-forge/tree/main/packages/import-xlsx#readme",
  "bugs": {
    "url": "https://github.com/yourdevujjawal/devkit-forge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "devkit-forge",
    "data-import",
    "typescript",
    "xlsx",
    "excel"
  ]
}

{
  "name": "devkit-forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "docs:dev": "pnpm --filter @devkit-forge/docs dev",
    "docs:build": "pnpm --filter @devkit-forge/docs build",
    "docs:preview": "pnpm --filter @devkit-forge/docs preview",
    "test:e2e": "playwright test",
    "check:pack": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@playwright/test": "^1.56.1"
  }
}

{
  "name": "devkit-forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "pnpm --filter @devkit-forge/docs dev",
    "docs:build": "pnpm --filter @devkit-forge/docs build",
    "docs:preview": "pnpm --filter @devkit-forge/docs preview",
    "test:e2e": "playwright test && playwright test --config playwright.vanilla.config.ts",
    "check:pack": "node scripts/check-packages.mjs"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.5"
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.56.1"
  }
}
